---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FontPreload from '../components/FontPreload.astro';
import FaviconHead from '../components/FaviconHead.astro';
import { copy, locales, pageUrl, type Locale, type Page } from '../i18n';
import { site, assets, deployment } from '../config/site';
import '../styles/global.css';
interface Props { locale: Locale; page: Page; }
const { locale, page } = Astro.props;
const t = copy[locale];
const title = t.titles[page] + ' | ' + site.name;
const canonical = new URL(pageUrl(locale, page), site.url);
const structuredData = {
  '@context': 'https://schema.org', ...site.business,
  '@id': site.url + '/#business', name: site.name, url: site.url,
  logo: new URL(assets.logo, site.url).href,
  image: new URL(assets.socialCard, site.url).href,
  hasMenu: new URL(pageUrl(locale, 'menu'), site.url).href,
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontPreload />
    <meta name="theme-color" content="#0D0802" />
    <title>{title}</title>
    <meta name="description" content={t.descriptions[page]} />
    <link rel="canonical" href={canonical} />
    {deployment.staging && <meta name="robots" content="noindex,nofollow" />}
    {locales.map(l => <link rel="alternate" hreflang={l} href={new URL(pageUrl(l, page), site.url)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pageUrl('nl', page), site.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.descriptions[page]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'nl' ? 'nl_NL' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'nl' ? 'en_GB' : 'nl_NL'} />
    <meta property="og:image" content={new URL(assets.socialCard, site.url)} />
    <meta property="og:image:alt" content={t.truckAlt} />
    <FaviconHead />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\u003c')} />
  </head>
  <body><Header locale={locale} page={page} /><main id="main" tabindex="-1"><slot /></main><Footer locale={locale} /></body>
</html>
