---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { assets } from '../config/site';
interface Props { kind?: keyof typeof assets; src?: string | ImageMetadata; alt?: string; label: string; eager?: boolean; }
const { kind = 'burger', src, alt = '', label, eager = false } = Astro.props;
const image = src ?? assets[kind];
const imageProps = { alt, loading: eager ? 'eager' as const : 'lazy' as const, fetchpriority: eager ? 'high' as const : 'auto' as const, decoding: 'async' as const };
---
<figure class:list={['media', 'media--' + kind]}>
  {typeof image === 'string' ? <Image src={image} width={960} height={720} {...imageProps} /> : <Image src={image} widths={[480, 768, 960]} sizes="(min-width: 64rem) 45vw, 100vw" {...imageProps} />}
  <figcaption>{label}</figcaption>
</figure>
