---
import { productGroups, allergenCategories, productAllergenState, indicatorSymbols, allergenCopy } from '../config/allergens';
import { pageUrl, type Locale } from '../i18n';
import IngredientDisclosure from './IngredientDisclosure.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = allergenCopy[locale];
---
<div class="section wrapper">
  <div class="allergen-layout">
    <aside class="allergy-notice" aria-labelledby="allergy-notice-title">
      <h2 id="allergy-notice-title">{t.noticeTitle}</h2>
      <p><strong>{t.notice}</strong></p>
    </aside>
    <nav aria-label={t.jump} class="page-jumps">
      <a href="#allergen-overview">01 · {t.overview}</a>
      <a href="#ingredients-guide">02 · {t.guide}</a>
      <a href="#important-information">03 · {t.information}</a>
    </nav>

    <section id="allergen-overview" aria-labelledby="overview-title">
      <h2 id="overview-title">{t.overview}</h2>
      <p id="matrix-help">{t.scroll}</p>
      <div id="allergen-legend" class="legend">
        <h3>{t.legend}</h3>
        <ul>
          {Object.entries(indicatorSymbols).map(([state, symbol]) => <li><span class={'indicator ' + state} aria-hidden="true">{symbol}</span> {t[state as keyof typeof indicatorSymbols]}</li>)}
          <li><span class="risk-symbol" aria-hidden="true">†</span> {t.risk}</li>
        </ul>
      </div>
      <div class="matrix-scroll" role="region" aria-labelledby="overview-title" aria-describedby="matrix-help allergen-legend" tabindex="0">
        <table class="allergen-matrix">
          <caption>{t.table}</caption>
          <colgroup><col class="product-column" />{allergenCategories.map(() => <col />)}</colgroup>
          <thead><tr><th scope="col" class="product-name">{t.product}</th>{allergenCategories.map(category => <th id={'allergen-' + category.id} scope="col"><span class="vertical-heading">{category.name[locale]}</span></th>)}</tr></thead>
          {productGroups.map(group => <tbody id={group.id}>
            <tr class="category-row"><th id={'category-' + group.id} scope="rowgroup" colspan={15}>{group.legacyId && <span id={group.legacyId}></span>}{group.name[locale]}</th></tr>
            {group.products.map(product => <tr id={product.id} data-product={product.id}>
              <th id={'row-' + product.id} class="product-name" scope="row">
                <a href={'#ingredients-' + product.id} aria-label={product.name[locale] + ' — ' + t.guide}>{product.name[locale]} <span aria-hidden="true">↘</span></a>
                {product.sharedFryer && <a class="risk-symbol" href="#important-information" aria-label={t.risk}>†</a>}
              </th>
              {allergenCategories.map(category => {
                const state = productAllergenState(product, category.id);
                return <td headers={'row-' + product.id + ' allergen-' + category.id} data-allergen={category.id} data-state={state}><span class={'indicator ' + state} aria-hidden="true">{indicatorSymbols[state]}</span><span class="sr-only">{t[state]}</span></td>;
              })}
            </tr>)}
          </tbody>)}
        </table>
      </div>
    </section>

    <section id="ingredients-guide" aria-labelledby="ingredients-title">
      <h2 id="ingredients-title">{t.guide}</h2><p>{t.guideIntro}</p>
      {productGroups.map(group => <div class="guide-group">
        <h3>{group.name[locale]}</h3>
        {group.products.map(product => <article id={'ingredients-' + product.id} class="product-guide">
          <h4>{product.name[locale]} {product.sharedFryer && <a class="risk-symbol" href="#important-information" aria-label={t.risk}>†</a>}</h4>
          {product.recipe.map(item => <IngredientDisclosure ingredientId={item.ingredient} quantity={item.quantity} locale={locale} />)}
          <a class="back-link" href={'#' + product.id}>{t.backMatrix} ↑</a>
        </article>)}
      </div>)}
    </section>

    <section id="important-information" aria-labelledby="information-title">
      <h2 id="information-title">{t.information}</h2>
      <p><strong>{t.notice}</strong></p><p>{t.limits}</p><p>{t.specification}</p>
      <p class="fryer-notice"><strong><span aria-hidden="true">†</span> {t.fryer}</strong></p>
      <p><a class="back-link" href={pageUrl(locale, 'menu')}>{t.back} →</a></p>
    </section>
  </div>
</div>
<style>
  .allergen-layout { background: #fff; color: var(--brand-black); padding: clamp(1rem, 3vw, 2.5rem); min-width: 0; }
  .allergen-layout :is(h2, h3, h4) { color: var(--brand-black); }
  .allergen-layout h2 { font-size: clamp(1.65rem, 4vw, 2.6rem); }
  .allergen-layout h3 { font-size: 1.25rem; }
  .allergen-layout h4 { font-size: 1.15rem; margin: 0 0 1rem; }
  .allergen-layout :is(section, tbody, tr, article, span[id]) { scroll-margin-top: 1rem; }
  .allergen-layout a { color: var(--brand-black); text-decoration-thickness: 1px; }
  .allergen-layout a:hover { text-decoration-thickness: 3px; }
  .allergen-layout :focus-visible { outline: 3px solid var(--brand-black); outline-offset: 3px; }
  .allergy-notice { padding: clamp(1rem, 2vw, 1.5rem); background: var(--brand-yellow); border-left: 6px solid var(--brand-black); }
  .allergy-notice h2 { font-size: clamp(1.3rem, 3vw, 1.75rem); line-height: 1.3; }
  .page-jumps { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-block: 1.5rem 3rem; font-weight: 700; }
  .page-jumps a, .back-link { display: inline-flex; align-items: center; min-height: 44px; }
  .legend { background: #f3f3f3; padding: 1rem; margin-block: 1.25rem; }
  .legend ul { list-style: none; padding: 0; margin: .75rem 0 0; display: grid; gap: .65rem; }
  .legend li { display: flex; gap: .6rem; align-items: baseline; }
  .matrix-scroll { max-width: 100%; overflow-x: auto; border: 1px solid #bbb; isolation: isolate; }
  .allergen-matrix { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 68rem; table-layout: fixed; color: var(--brand-black); font-size: .85rem; }
  caption { text-align: left; padding: .85rem 1rem; font-weight: 700; background: #fff; }
  .product-column { width: 14rem; }
  th, td { padding: .6rem .3rem; border-right: 1px solid #d1d1d1; border-bottom: 1px solid #d1d1d1; text-align: center; background: #fff; }
  thead th { background: var(--brand-black); color: #fff; height: 15rem; vertical-align: bottom; }
  .vertical-heading { display: inline-block; writing-mode: vertical-rl; transform: rotate(180deg); text-align: left; max-height: 14rem; }
  .product-name { position: sticky; left: 0; z-index: 2; text-align: left; padding: .65rem .85rem; box-shadow: 2px 0 0 #bbb; }
  thead .product-name { z-index: 3; vertical-align: bottom; }
  .product-name a { min-height: 44px; display: inline-flex; align-items: center; }
  tbody tr:nth-child(even) > :is(th, td) { background: #f1f1f1; }
  .category-row th { background: var(--brand-yellow); color: var(--brand-black); text-align: left; padding: .65rem 1rem; font-size: 1rem; }
  .indicator { display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; flex: 0 0 1.75rem; font-weight: 800; }
  .contains { background: var(--brand-yellow); border-radius: 50%; }
  .unavailable { border: 1px solid #777; color: #444; }
  .notIdentified { color: #555; }
  .risk-symbol { font-weight: 900; font-size: 1.25rem; padding-inline: .3rem; }
  #ingredients-guide, #important-information { margin-top: 3rem; }
  .guide-group { margin-top: 2rem; }
  .guide-group > h3 { background: var(--brand-yellow); padding: .75rem 1rem; }
  .product-guide { padding-block: 1.5rem; border-bottom: 1px solid #ccc; }
  .back-link { margin-top: .75rem; font-weight: 700; }
  .fryer-notice { background: #f3f3f3; border-left: 4px solid var(--brand-yellow); padding: 1rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 30rem) { .product-column { width: 10rem; } }
  @media print { .matrix-scroll { overflow: visible; } .allergen-matrix { min-width: 0; font-size: .6rem; } .product-column { width: 10rem; } .product-name { position: static; } }
</style>
