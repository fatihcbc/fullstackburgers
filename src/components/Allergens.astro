---
import { allergenSections, allergenCopy } from '../config/allergens';
import { pageUrl, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = allergenCopy[locale];
---
<div class="section wrapper allergen-content">
  <aside class="allergy-notice" aria-labelledby="allergy-notice-title">
    <h2 id="allergy-notice-title">{t.noticeTitle}</h2>
    <p><strong>{t.notice}</strong></p><p>{t.limits}</p>
  </aside>
  <nav aria-label={t.jump} class="allergen-jumps">
    {allergenSections.map(section => <a class="text-link" href={'#' + section.id}>{section.title[locale]}</a>)}
  </nav>
  {allergenSections.map(section => <section id={section.id} class="allergen-section" aria-labelledby={section.id + '-title'}>
    <h2 id={section.id + '-title'}>{section.title[locale]}</h2>
    {section.items.map(item => <article id={item.id} class="allergen-card">
      <h3>{item.name[locale]}</h3>
      {item.note && <p>{item.note[locale]}</p>}
      {item.known && <p><strong>{t.known}:</strong> {item.known[locale]}</p>}
      {item.pending && <p class="verification-note"><strong>{section.id === 'fries' ? t.fryer : t.pending}:</strong> {item.pending[locale]}</p>}
    </article>)}
  </section>)}
  <p><a class="text-link" href={pageUrl(locale, 'menu')}>{t.back}</a></p>
</div>
<style>
  .allergen-content { max-width: 58rem; }
  .allergy-notice { padding: clamp(1rem, 3vw, 2rem); border: 2px solid var(--brand-yellow); background: var(--color-soft); }
  .allergy-notice h2 { font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.3; }
  .allergen-jumps { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-block: 1.5rem; }
  .allergen-section { margin-block: 3rem; }
  .allergen-section, .allergen-card { scroll-margin-top: 1.5rem; }
  .allergen-card { padding: clamp(1rem, 3vw, 1.5rem); border: 1px solid var(--color-line); margin-top: 1rem; overflow-wrap: anywhere; }
  .allergen-card h3 { margin-bottom: 1rem; }
  .verification-note { padding-left: 1rem; border-left: 3px solid var(--brand-yellow); }
</style>
