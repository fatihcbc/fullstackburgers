---
import { getCollection } from 'astro:content';
import { copy, type Locale } from '../i18n';
import { formatPrice } from '../config/business';
interface Props { locale: Locale; retro?: boolean; }
const { locale, retro = false } = Astro.props;
const t = copy[locale];
const burgers = (await getCollection('burgers', ({ data }) => data.locale === locale && !data.draft && !data.placeholder)).sort((a, b) => a.data.order - b.data.order);
---
<div class={retro ? 'retro-menu-grid' : 'burger-grid'}>{burgers.map(({ data }) => <article class={retro ? 'retro-menu-card' : 'burger-card'}>
  <div class={retro ? undefined : 'card-body'}>
    <h3>{data.title}</h3><p class="burger-description">{data.description}</p>
    <dl class="burger-prices"><div><dt>{t.burger}</dt><dd>{formatPrice(data.priceCents, locale)}</dd></div><div><dt>{t.combo}</dt><dd>{formatPrice(data.comboPriceCents, locale)}</dd></div></dl>
  </div>
</article>)}</div>
<p class="combo-note">{t.comboIncludes}</p>
<style>
  h3 { overflow-wrap: break-word; }
  .burger-description { margin-top: .75rem; }
  .burger-prices { margin: 1.25rem 0 0; }
  .burger-prices > div { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: baseline; justify-content: space-between; padding-block: .35rem; }
  dd { margin: 0; font-weight: 700; color: var(--brand-yellow); white-space: nowrap; }
  .combo-note { margin-top: 1rem; color: var(--brand-gray); }
</style>
