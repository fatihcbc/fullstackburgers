---
import { Picture } from 'astro:assets';
import poster from '../../public/media/posters-01.jpg';
import BurgerGrid from './BurgerGrid.astro';
import OpeningPricesNotice from './OpeningPricesNotice.astro';
import { sides, formatPrice } from '../config/business';
import { copy, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<section class="section wrapper menu-layout" aria-labelledby="menu-title">
  <div class="menu-opening"><OpeningPricesNotice locale={locale} /></div>
  <div class="menu-poster"><h2 id="menu-title">{t.posterTitle}</h2>
    <a class="poster-image" href="/media/posters-01.jpg" aria-label={t.posterOpen}><Picture src={poster} widths={[480, 960, 1440, 2200]} sizes="(min-width: 64rem) 50vw, calc(100vw - 32px)" formats={['webp']} fallbackFormat="jpeg" quality={88} alt={t.posterAlt} loading="eager" fetchpriority="high" /></a>
    <a class="text-link" href="/media/posters-01.jpg">{t.posterOpen} ↗</a>
  </div>
  <div class="menu-prices"><h2>{t.showcase}</h2><BurgerGrid locale={locale} showNotice={false} />
    <h3 class="sides-title">{t.sidesTitle}</h3><dl class="side-prices">{sides.map(side => <div><dt>{side.name[locale]}</dt><dd>{formatPrice(side.priceCents, locale)}</dd></div>)}</dl>
  </div>
</section>
<style>
  .menu-layout { display: grid; gap: 3rem; }
  .menu-layout > div { min-width: 0; }
  .menu-opening { grid-column: 1 / -1; }
  .poster-image { display: block; }
  .poster-image :global(img) { display: block; width: 100%; height: auto; }
  .menu-prices :global(.burger-grid) { grid-template-columns: 1fr; }
  .sides-title { margin-top: 2rem; }
  .side-prices { margin: 1rem 0 0; }
  .side-prices > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--color-line); }
  dd { margin: 0; color: var(--brand-yellow); font-weight: 700; white-space: nowrap; }
  @media (min-width: 64rem) { .menu-layout { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; } }
</style>
